<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sdh.healthcare</groupId>
    <artifactId>healthcare-source-connectors</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- The convert stage (STAGES.md §9): converts split records to JSON, stores them in records, and sends the
       producer's results. Its image, distribution kit and ITs come in step 4d. -->
  <artifactId>convert-stage</artifactId>
  <name>convert-stage</name>

  <dependencyManagement>
    <dependencies>
      <!-- Jackson 2 at the parent's security override, ahead of Spring Boot, as in file-connector. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson2.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>${camel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <!-- Everything but the conversion: the worker, source and sink, reconciler, results, runtime and admin
           (STAGES.md §17). -->
      <groupId>com.sdh.healthcare</groupId>
      <artifactId>connector-record-stage</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Third-party attribution in the jar (design §14.2), as for the other applications. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
          <!-- The build's version and time, in the processor's version (STAGES.md §6). -->
          <execution>
            <id>build-info</id>
            <goals><goal>build-info</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- Distribution kit (design §14.3), as for file-connector: the jar, attribution, configuration, the start
           and admin scripts, the customer Dockerfile and the zstd/snappy native libraries for both architectures.
           Built as a directory on every package (the customer image is built from it); -Pdist adds the tarball. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>packaging-extras</id>
            <phase>generate-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <!-- What repackaging adds that isn't a dependency: Spring Boot's jar mode tools (the service image's
                   Dockerfile extracts its layers with them). Copied here only so the attribution step can read
                   their license files (design §14.2); src/license/bundled-by-packaging.properties names them. -->
              <artifactItems>
                <artifactItem>
                  <groupId>org.springframework.boot</groupId>
                  <artifactId>spring-boot-jarmode-tools</artifactId>
                  <version>${spring-boot.version}</version>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/packaging-extras</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>dist-native-libraries</id>
            <phase>prepare-package</phase>
            <goals><goal>unpack-dependencies</goal></goals>
            <configuration>
              <includeArtifactIds>zstd-jni,snappy-java</includeArtifactIds>
              <includes>linux/amd64/*.so,linux/aarch64/*.so,org/xerial/snappy/native/Linux/x86_64/*.so,org/xerial/snappy/native/Linux/aarch64/*.so</includes>
              <outputDirectory>${project.build.directory}/dist-native</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- SBOM of the jar (design §14.4), declared before the assembly so the kit can include it. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>dist-dir</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <descriptors><descriptor>src/assembly/dist-dir.xml</descriptor></descriptors>
              <attach>false</attach>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The customer distribution tarball: target/convert-stage-<version>-dist.tar.gz (design §14.3). -->
    <profile>
      <id>dist</id>
      <properties>
        <!-- A license text that couldn't be fetched fails the build (design §14.2). -->
        <license.strict>true</license.strict>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <executions>
              <execution>
                <id>dist-tarball</id>
                <phase>package</phase>
                <goals><goal>single</goal></goals>
                <configuration>
                  <descriptors><descriptor>src/assembly/dist.xml</descriptor></descriptors>
                  <attach>false</attach>
                  <tarLongFileMode>posix</tarLongFileMode>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- The service and customer images, built into the sdh-it VM's Docker by scripts/build-image.sh from what this
         build packaged (design §14.1, §14.3):
         ./mvnw -Pimages -pl landing-connector,file-connector,convert-stage -am verify -DskipTests.
         The VM is stopped afterwards unless -Dimages.stop-vm=false. For a release, scripts/sign-release.sh builds,
         signs and pushes them (§14.4). -->
    <profile>
      <id>images</id>
      <properties>
        <license.strict>true</license.strict>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>customer-image</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${maven.multiModuleProjectDirectory}/scripts/build-image.sh</executable>
                  <arguments>
                    <argument>${project.artifactId}</argument>
                    <argument>customer</argument>
                  </arguments>
                  <environmentVariables>
                    <SDH_SKIP_MAVEN>1</SDH_SKIP_MAVEN>
                    <SDH_IT_STOP>false</SDH_IT_STOP>
                  </environmentVariables>
                </configuration>
              </execution>
              <execution>
                <id>service-image</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${maven.multiModuleProjectDirectory}/scripts/build-image.sh</executable>
                  <arguments>
                    <argument>${project.artifactId}</argument>
                    <argument>service</argument>
                  </arguments>
                  <environmentVariables>
                    <SDH_SKIP_MAVEN>1</SDH_SKIP_MAVEN>
                    <SDH_IT_STOP>${images.stop-vm}</SDH_IT_STOP>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
