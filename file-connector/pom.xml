<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sdh.healthcare</groupId>
    <artifactId>healthcare-source-connectors</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>file-connector</artifactId>
  <name>file-connector</name>

  <dependencyManagement>
    <dependencies>
      <!-- Jackson 2 at the parent's security override (design §14.5). Imported again here, ahead of Spring Boot:
           an imported BOM in the parent doesn't win over this module's own imports, and Boot 4.1.2 would bring
           2.21.x. Spring itself uses Jackson 3, so this only affects Iceberg and the cloud clients. The parent's
           other overrides are plain entries, which do win. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson2.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>${camel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Settings, keys, publishers, telemetry export and the lease database, with every client library
         (design §3). -->
    <dependency>
      <groupId>com.sdh.healthcare</groupId>
      <artifactId>connector-runtime</artifactId>
    </dependency>
    <dependency>
      <!-- The performance test support (design §13.1): settings, workloads, measurement and results. -->
      <groupId>com.sdh.healthcare</groupId>
      <artifactId>connector-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- The demo (-Pdemo, design §15.3): a broker both apps reach without Docker, an OTLP receiver for their
         telemetry, and certificates for the HTTP push intake. -->
    <dependency>
      <groupId>org.apache.artemis</groupId>
      <artifactId>artemis-jakarta-server</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry.proto</groupId>
      <artifactId>opentelemetry-proto</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java-util</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Integration tests (-Pit): real storage and brokers in containers. -->
    <dependency>
      <groupId>com.sdh.healthcare</groupId>
      <artifactId>connector-queue-reader</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-activemq</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-gcloud</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-azure</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-mssqlserver</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-vault</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.nagyesta.lowkey-vault</groupId>
      <artifactId>lowkey-vault-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Lowkey's client factory (emulator certificate, auth) lives here; optional in the Testcontainers module. -->
    <dependency>
      <groupId>com.github.nagyesta.lowkey-vault</groupId>
      <artifactId>lowkey-vault-client</artifactId>
      <version>${lowkey-vault.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion><groupId>com.azure</groupId><artifactId>azure-core-http-netty</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- Testcontainers checks SQL Server (the Service Bus emulator's store) is ready over JDBC. -->
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Third-party attribution for everything this jar bundles: META-INF/THIRD-PARTY.txt and licenses/ (design
           §14.2). The applications need it (landing-connector too): the images and the distribution archives are built
           from their jars, while the library jars bundle nothing and carry just our LICENSE and NOTICE. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- Distribution kit (design §14.3): the jar, attribution, configuration, start scripts, the customer
           Dockerfile and the zstd/snappy native libraries for both architectures, so a container needs no RUN step.
           Built as a directory on every package (the customer image is built from it); -Pdist adds the tarball. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>packaging-extras</id>
            <phase>generate-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <!-- What repackaging adds that isn't a dependency: Spring Boot's jar mode tools (the service image's
                   Dockerfile extracts its layers with them). Copied here only so the attribution step can read
                   their license files (design §14.2); src/license/bundled-by-packaging.properties names them. -->
              <artifactItems>
                <artifactItem>
                  <groupId>org.springframework.boot</groupId>
                  <artifactId>spring-boot-jarmode-tools</artifactId>
                  <version>${spring-boot.version}</version>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/packaging-extras</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>dist-native-libraries</id>
            <phase>prepare-package</phase>
            <goals><goal>unpack-dependencies</goal></goals>
            <configuration>
              <includeArtifactIds>zstd-jni,snappy-java</includeArtifactIds>
              <includes>linux/amd64/*.so,linux/aarch64/*.so,org/xerial/snappy/native/Linux/x86_64/*.so,org/xerial/snappy/native/Linux/aarch64/*.so</includes>
              <outputDirectory>${project.build.directory}/dist-native</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- SBOM of the jar (design §14.4), declared before the assembly so the kit can include it. -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>dist-dir</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <descriptors><descriptor>src/assembly/dist-dir.xml</descriptor></descriptors>
              <attach>false</attach>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The customer distribution tarball: target/file-connector-<version>-dist.tar.gz (design §14.3). -->
    <profile>
      <id>dist</id>
      <properties>
        <!-- A license text that couldn't be fetched fails the build (design §14.2). -->
        <license.strict>true</license.strict>
      </properties>
      <build>
        <plugins>
          <!-- The attribution in both applications' jars, checked against what they bundle (design §14.2): no
               Docker, and run even with -DskipTests, since this is what customers receive. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>attribution-check</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <includes><include>**/ThirdPartyAttributionIT.java</include></includes>
                  <skipTests>false</skipTests>
                  <skipITs>false</skipITs>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <executions>
              <execution>
                <id>dist-tarball</id>
                <phase>package</phase>
                <goals><goal>single</goal></goals>
                <configuration>
                  <descriptors><descriptor>src/assembly/dist.xml</descriptor></descriptors>
                  <attach>false</attach>
                  <tarLongFileMode>posix</tarLongFileMode>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- The service and customer images, built into the sdh-it VM's Docker by scripts/build-image.sh from what this
         build packaged (design §14.1, §14.3): ./mvnw -Pimages -pl landing-connector,file-connector -am verify
         -DskipTests. The VM is stopped afterwards unless -Dimages.stop-vm=false. For a release, scripts/sign-release.sh
         builds, signs and pushes them (§14.4). -->
    <profile>
      <id>images</id>
      <properties>
        <license.strict>true</license.strict>
      </properties>
      <build>
        <plugins>
          <!-- The attribution in both applications' jars, checked against what they bundle (design §14.2): no
               Docker, and run even with -DskipTests, since this is what customers receive. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>attribution-check</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <includes><include>**/ThirdPartyAttributionIT.java</include></includes>
                  <skipTests>false</skipTests>
                  <skipITs>false</skipITs>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>customer-image</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${maven.multiModuleProjectDirectory}/scripts/build-image.sh</executable>
                  <arguments>
                    <argument>${project.artifactId}</argument>
                    <argument>customer</argument>
                  </arguments>
                  <environmentVariables>
                    <SDH_SKIP_MAVEN>1</SDH_SKIP_MAVEN>
                    <SDH_IT_STOP>false</SDH_IT_STOP>
                  </environmentVariables>
                </configuration>
              </execution>
              <execution>
                <id>service-image</id>
                <phase>verify</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>${maven.multiModuleProjectDirectory}/scripts/build-image.sh</executable>
                  <arguments>
                    <argument>${project.artifactId}</argument>
                    <argument>service</argument>
                  </arguments>
                  <environmentVariables>
                    <SDH_SKIP_MAVEN>1</SDH_SKIP_MAVEN>
                    <SDH_IT_STOP>${images.stop-vm}</SDH_IT_STOP>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
