# Example configuration for the file connector's split stage (Smile Digital Health Inc.). Copy to application.yml
# in this directory and adjust. Values shown are defaults where they exist; remove what you don't need.
# Secrets don't belong here: use environment variables (SDH_CRYPTO_KEYSTORE_PASSWORD,
# SDH_CRYPTO_KEYS_SIGNING_PASSPHRASE, SDH_CRYPTO_KEYS_INBOX_PASSPHRASE, SDH_LEASE_JDBC_PASSWORD, ...) or a configtree:
# mount.
sdh:
  connector-id: file-connector
  encrypt-workers: 0              # 0 = one per CPU core
  landing:                        # where items come from: one landing node's intake (see its distribution)
    intake: claims                # must match the landing node's sdh.landing.intake
    storage:                      # the landing node's catalog; catalog defaults to sdh.storage.catalog
      catalog-name: sdh
      namespace: sdh_landing
      # catalog: { ... }          # only if landing uses another catalog or storage account
    reconcile:                    # items whose item.landed was lost are split anyway, by one pod
      enabled: true
      grace: 10m
      interval: 15m
  stage:
    input:                        # where the landing node sends item.landed
      type: kafka                 # kafka | sqs | rabbitmq | artemis | pubsub | servicebus | eventhubs
      # A Camel consumer URI (not for artemis). The options that hold a message until its item is split are added,
      # and any set otherwise refused. Secrets must be placeholders, such as {{env:KAFKA_JAAS}}, never values.
      uri: "kafka:sdh.landing.claims?brokers=kafka:9093&groupId=file-connector&securityProtocol=SSL"
      batch: { max-messages: 1 }  # the default here: a batch is held until each of its items is split
      artemis: { broker-url: "tcp://artemis:61617?sslEnabled=true", username: sdh }   # artemis only
    output:                       # where record.split and item.split go
      type: kafka                 # kafka | sqs | pubsub | servicebus | eventhubs | artemis | rabbitmq | camel
      uri: "kafka:sdh.split.claims?brokers=kafka:9093&securityProtocol=SSL"
      artemis: { broker-url: "tcp://artemis:61617?sslEnabled=true", username: sdh }
    registry-schema: sdh_stage    # Postgres schema of the items' checkpoints (split_item), in the lease database
  split:
    format: ccda                  # ccda | xml | x12 | edifact | fhir | csv | delimited | parquet | <plugin>
    boundary: ClinicalDocument    # optional; format default
    options:                      # format options; nested keys become dotted names
      namespace: urn:hl7-org:v3
      csv: { header: true }       # → csv.header
      fhir: { ndjson-group-size: 0 }
      delimited: { pattern: "^MSH\\|", mode: START }
    limits: { max-item-bytes: 1TB, max-record-bytes: 512MB }    # omitted = format defaults
  storage:
    catalog-name: sdh             # also sent in messages
    namespace: sdh_ingest         # holds split_records, which every pod appends to
    catalog:                      # Iceberg catalog properties, passed through unchanged
      type: rest                  # rest | jdbc
      uri: https://polaris:8181/api/catalog
      warehouse: sdh              # the Polaris catalog name
      rest.auth.type: oauth2
      credential: "sdh-connector:${POLARIS_CLIENT_SECRET}"   # client id:secret, secret from the environment
      scope: PRINCIPAL_ROLE:ALL
      oauth2-server-uri: https://polaris:8181/api/catalog/v1/oauth/tokens
      io-impl: org.apache.iceberg.aws.s3.S3FileIO   # or ...gcp.gcs.GCSFileIO, ...azure.adlsv2.ADLSFileIO
      s3: { endpoint: "https://seaweedfs:8333", path-style-access: true }
      client: { region: us-east-1 }
    commit: { max-records: 10000, max-bytes: 512MB, max-interval: 30s }
  lease:                          # item leases (split/<connector-id>/<item>) and the duties lease
    jdbc: { url: "jdbc:postgresql://postgres:5432/sdh?sslmode=verify-full", username: sdh, table: sdh_lease }
    ttl: 60s
    renew-interval: 15s
    safety-margin: 10s
  crypto:
    wrap-provider: local          # local | aws-kms | gcp-kms | azure-keyvault | vault-transit
    sign-provider: local          # same choices, independently
    keystore: { path: /run/secrets/keks.p12 }               # local only; password: SDH_CRYPTO_KEYSTORE_PASSWORD
    keys:
      records-kek: records-kek/1                            # keystore alias, or the KMS key ref
      landed-items-kek: landed-items-kek/1                  # unwrap only: reads landed items
      signing: { kid: connector-2026, pem: /run/secrets/signing.pem }   # local; passphrase: env
      # signing: { kid: connector-2026, key-ref: "arn:aws:kms:eu-west-1:123456789012:key/…" }   # KMS
      recipient: { kid: downstream-2026, pem: /run/secrets/recipient.pem, sha256: "ab12..." }
      inbox: { kid: splitter-2026, pem: /run/secrets/inbox.pem }   # item.landed is encrypted to this; passphrase: env
      landing-signer: { kid: landing-2026, pem: /run/secrets/landing-signer.pem }   # the landing node's public key
    aws: { region: eu-west-1 }                              # aws-kms; credentials: default chain
    gcp: { endpoint: "europe-west1-kms.googleapis.com:443" }  # gcp-kms; credentials: ADC
    vault: { address: "https://vault:8200", token-file: /vault/secrets/token, mount: transit }   # vault-transit
  retry: { max-attempts: 8, initial-backoff: 200ms, max-backoff: 30s }
  telemetry:                      # unset endpoint = no export
    otlp: { endpoint: "https://otel-collector:4318", timeout: 10s }   # headers: { Authorization: ... } from env
    metric-interval: 60s
  maintenance:                    # run by the pod that holds the duties lease
    enabled: true
    interval: 1h
    snapshot-retention: 7d
    min-snapshots: 10
    compaction: { enabled: true, small-file-fraction: 0.75, min-input-files: 5, max-bytes-per-run: 8GB }
    orphans: { enabled: true, interval: 24h, min-age: 3d }
    retention: { records: 30d }   # split_records; unset = keep forever (default)
