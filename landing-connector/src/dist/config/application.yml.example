# Example configuration for a landing node (Smile Digital Health Inc.). Copy to application.yml in this directory
# and adjust. Values shown are defaults where they exist; remove what you don't need. Run one node per intake, and
# optionally a standby beside it (standby: true) that takes over when the active node stops.
# Secrets don't belong here: use environment variables (SDH_CRYPTO_KEYSTORE_PASSWORD,
# SDH_CRYPTO_KEYS_SIGNING_PASSPHRASE, SDH_LEASE_JDBC_PASSWORD, ...) or a configtree: mount.
sdh:
  connector-id: landing-claims
  landing:
    intake: claims                # names the lease (landing/<intake>), the checkpoint and the ledger entries
    standby: false                # true: wait for the lease for as long as it takes
    source:
      path: /data/intake
      access: read-only           # read-only | read-write (checked at startup with a probe file)
      after: delete               # read-write only: delete | move | rename
      move-to: /data/intake-landed   # for move; relative paths are kept
      rename-suffix: .landed      # for rename
      ready: settled              # settled (unchanged for settle) | marker (<name>.done)
      settle: 2m
      include: "*"                # Ant-style
      recursive: false
      poll-interval: 10s
      type: directory             # directory | sftp | smb | s3 | azure-blob | gcs | iceberg | http | queue; for sftp,
                                  # smb and buckets, path and move-to are absolute (in a bucket, key prefixes: / is
                                  # its root)
      auth-retry-interval: 5m     # remote sources: wait after refused credentials, a missing share or bucket, or a
                                  # new host key
      sftp:                       # type: sftp
        host: dropzone.example.org
        port: 22
        user: sdh
        private-key: /run/secrets/sftp_key   # OpenSSH format; SDH_LANDING_SOURCE_SFTP_PRIVATE_KEY_PASSPHRASE
        # or a password: SDH_LANDING_SOURCE_SFTP_PASSWORD
        known-hosts: /run/secrets/known_hosts    # required: the server's pinned host key
        connect-timeout: 15s
        read-timeout: 60s         # a stalled connection is dropped within this
      smb:                        # type: smb (SMB 3, encryption required, NTLMv2)
        host: fileserver.example.org
        port: 445
        share: outbound           # the share name alone; path and move-to are within it, / being its root
        domain: EXAMPLE
        user: sdh                 # password: SDH_LANDING_SOURCE_SMB_PASSWORD
        connect-timeout: 15s
        read-timeout: 60s
      bucket:                     # type: s3 | azure-blob | gcs; objects appear whole, so settle: 0s is usually enough
        name: claims-drop         # the bucket, or the Azure container
        # region: eu-west-1       # s3; default from the environment
        # endpoint: "https://seaweedfs:8333"   # s3: an S3-compatible store (with path-style-access: true);
        #                                      # azure-blob: https://<account>.blob.core.windows.net; gcs: an emulator
        # path-style-access: false
        # access-key-id: AKIA...  # s3; secret: SDH_LANDING_SOURCE_BUCKET_SECRET_ACCESS_KEY; else the default chain
        # connection-string: SDH_LANDING_SOURCE_BUCKET_CONNECTION_STRING (env)   # azure-blob; else endpoint + default
        #                                                                         # Azure credential
        # project-id: my-project  # gcs; credentials: Google application default credentials
        # anonymous: false        # send no credentials (a public bucket, or an emulator)
        connect-timeout: 15s
        read-timeout: 60s
      table:                      # type: iceberg (access: read-only); each Parquet data file an append adds is an item
        catalog:                  # the source table's own catalog: Iceberg catalog properties, passed through unchanged
          type: rest
          uri: https://producer-catalog:8181/api/catalog
          warehouse: claims
          credential: "sdh-reader:${SOURCE_CATALOG_SECRET}"
        catalog-name: source
        identifier: ehr.claims    # namespace.table
        start: earliest           # earliest: the rows the table holds now, then each append | latest: only later
                                  # appends
    http:                         # type: http; producers POST to https://<host>:<port>/intakes/<intake>/items
      port: 8443
      tls:                        # required; key password: SDH_LANDING_HTTP_TLS_PRIVATE_KEY_PASSWORD
        certificate: /run/secrets/tls.crt   # PEM, with its chain
        private-key: /run/secrets/tls.key   # PEM
      auth: oauth2                # oauth2 | mtls
      oauth2:                     # a bearer JWT: signed by the issuer, for the audience, with the scope
        issuer: https://idp.example.org/realms/producers
        # jwk-set-uri: https://idp.example.org/realms/producers/certs   # default: from the issuer's metadata
        audience: sdh-landing
        scope: sdh.push
      # mtls:                     # a client certificate from a trusted CA, with a listed subject
      #   trusted-cas: /run/secrets/producer-ca.pem
      #   subjects: ["CN=claims-producer,O=Example"]
      max-item-bytes: 0           # 0 = no limit; larger pushes get 413
      max-wait: 30s               # a push waits this long for the one before it, then gets 503
      retry-after: 30s            # the Retry-After sent with a 503
      read-timeout: 60s           # a stalled sender is dropped after this
    broker:                       # type: queue; messages are landed in batches, acknowledged only once landed
      type: kafka                 # kafka | sqs | rabbitmq | artemis | pubsub | servicebus | eventhubs
      # A Camel consumer URI (not for artemis). The options that hold a message until it is landed are added, and
      # any set otherwise refused. Secrets must be placeholders, such as {{env:KAFKA_JAAS}}, never values.
      uri: "kafka:hl7.adt?brokers=kafka:9093&groupId=sdh-landing-adt&securityProtocol=SSL"
      # uri: "aws2-sqs:hl7-adt?region=eu-west-1&useDefaultCredentialsProvider=true"
      # uri: "spring-rabbitmq:default?queues=hl7.adt"   # the queue must exist; it isn't declared
      # uri: "google-pubsub:my-project:hl7-adt-landing"  # a subscription; default Google credentials
      # uri: "azure-servicebus:hl7-adt?credentialType=AZURE_IDENTITY&fullyQualifiedNamespace=ns.servicebus.windows.net"
      # uri: "azure-eventhubs:ns/hl7-adt?consumerGroupName=sdh-landing&connectionString=RAW({{env:EVENTHUBS_CS}})"
      batch:                      # a batch closes at whichever comes first; one batch is one landed item
        max-messages: 1000
        max-bytes: 64MB           # a single larger message is a batch of its own
        max-wait: 5s
      dedup-window: 1h            # a message delivered again within this of the last batch is recognised by its ID
      rabbitmq:                   # type: rabbitmq; password: SDH_LANDING_BROKER_RABBITMQ_PASSWORD
        addresses: "rabbitmq:5671"
        virtual-host: /
        username: sdh
        ssl: true
      artemis:                    # type: artemis; password: SDH_LANDING_BROKER_ARTEMIS_PASSWORD
        broker-url: "tcp://artemis:61617?sslEnabled=true"
        username: sdh
        queue: hl7.adt
      eventhubs:                  # type: eventhubs; where checkpoints are kept: an existing blob container
        checkpoint-endpoint: "https://account.blob.core.windows.net"   # with the default Azure credential, or
        # checkpoint-connection-string: SDH_LANDING_BROKER_EVENTHUBS_CHECKPOINT_CONNECTION_STRING (env)
        checkpoint-container: sdh-landing-checkpoints
  storage:
    catalog-name: sdh             # also sent in item.landed messages
    namespace: sdh_landing
    commit-bytes: 512MB
    catalog:                      # Iceberg catalog properties, passed through unchanged
      type: rest                  # rest | jdbc
      uri: https://polaris:8181/api/catalog
      warehouse: sdh              # the Polaris catalog name
      rest.auth.type: oauth2
      credential: "sdh-landing:${POLARIS_CLIENT_SECRET}"   # client id:secret, secret from the environment
      scope: PRINCIPAL_ROLE:ALL
      oauth2-server-uri: https://polaris:8181/api/catalog/v1/oauth/tokens
      io-impl: org.apache.iceberg.aws.s3.S3FileIO   # or ...gcp.gcs.GCSFileIO, ...azure.adlsv2.ADLSFileIO
      s3: { endpoint: "https://seaweedfs:8333", path-style-access: true }
      client: { region: us-east-1 }
  lease:                          # the name is always landing/<intake>
    jdbc: { url: "jdbc:postgresql://postgres:5432/sdh?sslmode=verify-full", username: sdh, table: sdh_lease }
    ttl: 60s
    renew-interval: 15s
    safety-margin: 10s
  crypto:
    wrap-provider: local          # local | aws-kms | gcp-kms | azure-keyvault | vault-transit
    sign-provider: local          # same choices, independently
    keystore: { path: /run/secrets/keks.p12 }               # local only; password: SDH_CRYPTO_KEYSTORE_PASSWORD
    keys:
      landed-items-kek: landed-items-kek/1                  # keystore alias, or the KMS key ref
      signing: { kid: landing-2026, pem: /run/secrets/signing.pem }   # local; passphrase: env
      # signing: { kid: landing-2026, key-ref: "arn:aws:kms:eu-west-1:123456789012:key/…" }   # KMS
      recipient: { kid: splitter-2026, pem: /run/secrets/splitter-inbox.pem, sha256: "ab12..." }   # the splitter's inbox public key
    aws: { region: eu-west-1 }                              # aws-kms; credentials: default chain
    gcp: { endpoint: "europe-west1-kms.googleapis.com:443" }  # gcp-kms; credentials: ADC
    vault: { address: "https://vault:8200", token-file: /vault/secrets/token, mount: transit }   # vault-transit
  queue:                          # where item.landed goes; the splitter consumes it
    type: kafka                   # kafka | sqs | pubsub | servicebus | eventhubs | artemis | rabbitmq | camel
    uri: "kafka:sdh.landing.claims?brokers=kafka:9093&securityProtocol=SSL"
    artemis: { broker-url: "tcp://artemis:61617?sslEnabled=true", username: sdh }
  retry: { max-attempts: 8, initial-backoff: 200ms, max-backoff: 30s }
  telemetry:                      # unset endpoint = no export
    otlp: { endpoint: "https://otel-collector:4318", timeout: 10s }   # headers: { Authorization: ... } from env
    metric-interval: 60s
  maintenance:                    # runs between items, on landed_items and landing_ledger
    enabled: true
    interval: 1h
    snapshot-retention: 7d
    min-snapshots: 10
    compaction: { enabled: true, small-file-fraction: 0.75, min-input-files: 5, max-bytes-per-run: 8GB }
    orphans: { enabled: true, interval: 24h, min-age: 3d }
    retention: { landed-items: 3650d }   # unset = keep forever (default); at least 7d; the ledger is always kept
