<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sdh.healthcare</groupId>
    <artifactId>healthcare-source-connectors</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>connector-runtime</artifactId>
  <name>connector-runtime</name>
  <description>What the connector applications share (design §3): the common settings, key loading, the
    producer results channel, the PHI-filtered telemetry export, the lease database and the fatal-exit hook. Used by
    file-connector and landing-connector, which bring the client libraries for every broker (through
    connector-broker), store and KMS through it.</description>

  <dependencyManagement>
    <dependencies>
      <!-- Jackson 2 at the parent's security override (design §14.5). Imported again here, ahead of Spring Boot:
           an imported BOM in the parent doesn't win over this module's own imports, and Boot 4.1.2 would bring
           2.21.x. Spring itself uses Jackson 3, so this only affects Iceberg and the cloud clients. The parent's
           other overrides are plain entries, which do win. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson2.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>${camel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.sdh.healthcare</groupId>
      <artifactId>connector-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sdh.healthcare</groupId>
      <artifactId>connector-kms</artifactId>
    </dependency>
    <!-- Receiving from and sending to every broker (design §10.3), with their Camel components and clients. -->
    <dependency>
      <groupId>com.sdh.healthcare</groupId>
      <artifactId>connector-broker</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.camel.springboot</groupId>
      <artifactId>camel-file-starter</artifactId>
    </dependency>

    <!-- Telemetry (design §12): OpenTelemetry SDK with OTLP export of traces, metrics and audit logs. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <!-- Our own OTLP exporters, wrapped in the PHI allow-list filter (Boot's are switched off). -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <!-- The JVM's metrics (design §12.2): the starter brings it at run time; its settings are made here. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-otlp</artifactId>
    </dependency>

    <!-- Lease store (design §9.3). -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Object storage: S3FileIO for AWS S3 and S3-compatible stores such as SeaweedFS (design §8.1; MinIO is not supported). -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-aws</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>apache-client</artifactId>
    </dependency>
    <!-- Needed even without SSE-KMS: Iceberg's AwsProperties references KMS model classes when S3FileIO starts
         (found by FullStackIT). -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>kms</artifactId>
    </dependency>

    <!-- Object storage: GCSFileIO for Google Cloud Storage (design §8.1). -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-gcp</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-storage</artifactId>
    </dependency>
    <!-- Object storage: ADLSFileIO for Azure Data Lake Storage Gen2 (design §8.1). -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-azure</artifactId>
    </dependency>
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-storage-file-datalake</artifactId>
    </dependency>
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-identity</artifactId>
    </dependency>
    <!-- The HTTP client ADLSFileIO and the other Azure clients use (the Netty one is excluded, design §8.1). -->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-core-http-jdk-httpclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
