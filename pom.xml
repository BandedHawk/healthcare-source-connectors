  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Runtime stack (checked against Maven Central 2026-10-28) -->
    <spring-boot.version>4.1.2</spring-boot.version>
    <camel.version>4.22.2</camel.version>
    <!-- Changing Iceberg or Parquet fails IcebergUpgradeGuardTest until its review list is done (design §9.3). -->
    <iceberg.version>1.12.0</iceberg.version>
    <!-- Kept in step with the Parquet version Iceberg 1.12.0 is built against. -->
    <parquet.version>1.17.1</parquet.version>
    <hadoop.version>3.4.3</hadoop.version>
    <nimbus-jose.version>10.10</nimbus-jose.version>
    <zstd-jni.version>1.5.7-25</zstd-jni.version>
    <postgresql.version>42.7.14</postgresql.version>
    <slf4j.version>2.0.20</slf4j.version>

    <!-- Test -->
    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <embedded-postgres.version>2.2.2</embedded-postgres.version>
    <embedded-postgres-binaries.version>18.6.0</embedded-postgres-binaries.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <!-- Performance test settings (-Pperf, never part of a normal build; design §13.1). Override with
         -Dperf.size=4GiB, -Dperf.formats=ccda,x12,csv etc. -->
    <perf.size>1GiB</perf.size>
    <perf.formats>ccda,x12</perf.formats>
    <perf.storage>local</perf.storage>
    <perf.recipient>ec</perf.recipient>
    <!-- The heap the connector gets in the Kubernetes sketch (§14.1); -Dperf.heap=512m to try a smaller one. -->
    <perf.heap>1024m</perf.heap>
    <!-- Same as Spring Boot 4.1.2 manages, so connector-core's API matches the app's SDK. -->
    <opentelemetry.version>1.62.0</opentelemetry.version>
    <!-- KMS clients (connector-kms), chosen to match what Camel already brings: AWS SDK line, gax 2.83, azure-core 1.57. -->
    <awssdk.version>2.50.2</awssdk.version>
    <google-cloud-kms.version>2.98.0</google-cloud-kms.version>
    <azure-keyvault-keys.version>4.10.6</azure-keyvault-keys.version>
    <azure-identity.version>1.18.1</azure-identity.version>
    <!-- Azure's HTTP client: the JDK one, built on azure-core 1.57.1 like everything Azure here. The default Netty
         client is excluded, because it is built for Netty 4.1 and the app runs Netty 4.2 (Artemis, the AWS SDK). -->
    <azure-core-http-jdk-httpclient.version>1.1.3</azure-core-http-jdk-httpclient.version>
    <lowkey-vault.version>7.3.112</lowkey-vault.version>
    <!-- Third-party attribution (design §14.2), as in healthcare-data-harmonization. -->
    <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
    <gmavenplus-plugin.version>5.1.0</gmavenplus-plugin.version>
    <cyclonedx-maven-plugin.version>2.9.1</cyclonedx-maven-plugin.version>
    <groovy.version>4.0.33</groovy.version>
    <!-- Object storage clients for GCSFileIO and ADLSFileIO (iceberg-gcp, iceberg-azure leave them to us). Chosen on
         the same cores as above: google-cloud-storage 2.71.0 shares google-cloud-jar-parent 1.89.0 with KMS 2.98.0;
         datalake 12.25.0 is built on azure-storage-blob 12.32.0 and azure-core 1.57, which Camel already brings. -->
    <google-cloud-storage.version>2.71.0</google-cloud-storage.version>
    <azure-storage-datalake.version>12.25.0</azure-storage-datalake.version>

    <!-- Security overrides (design §14.5): versions newer than the libraries above bring, chosen to fix known
         vulnerabilities that scripts/vuln-scan.sh reports. Managed here, ahead of every module's BOM imports, so
         they win everywhere. Drop an override once the library that brings it has caught up.
         Jackson 2: Iceberg 1.12.0 is built against 2.22.x; Spring itself uses Jackson 3, so this only affects
         Iceberg, the Azure SDK and the cloud clients. -->
    <jackson2.version>2.22.3</jackson2.version>
    <!-- spring-rabbit 4.1.2 brings 5.30.0 -->
    <amqp-client.version>5.37.0</amqp-client.version>
    <!-- google-cloud-kms and google-cloud-storage bring 33.6.0 -->
    <guava.version>33.7.2-jre</guava.version>
    <!-- kafka-clients 4.2.2 and camel-kafka bring 1.11.1 and 1.1.10.7 -->
    <lz4-java.version>1.11.4</lz4-java.version>
    <snappy-java.version>1.1.10.12</snappy-java.version>
  </properties>

