<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sdh.healthcare</groupId>
    <artifactId>healthcare-source-connectors</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>connector-record-stage</artifactId>
  <name>connector-record-stage</name>
  <description>A record stage (STAGES.md §17): for each record message it receives, reads the record from its source
    table, makes one output with the stage's RecordTransform, stores it in its sink table and announces it; then the
    item's progress or end, and the producer's result if turned on. Queues, source and sink are chosen at run time.
    Used by the convert stage here and the transform stage in healthcare-data-transformer.</description>

  <dependencyManagement>
    <dependencies>
      <!-- As in connector-stage: Jackson 2 at the parent's security override (design §14.5), ahead of Spring Boot. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson2.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>${camel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- The worker, registry, duties, input from any broker and the admin CLI (STAGES.md §7). -->
    <dependency>
      <groupId>com.sdh.healthcare</groupId>
      <artifactId>connector-stage</artifactId>
    </dependency>
    <!-- Reads each record from the source table, as any downstream reader does. -->
    <dependency>
      <groupId>com.sdh.healthcare</groupId>
      <artifactId>connector-queue-reader</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real Postgres binaries, no Docker needed: the registry under the runtime's tests. -->
    <dependency>
      <groupId>io.zonky.test</groupId>
      <artifactId>embedded-postgres</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
