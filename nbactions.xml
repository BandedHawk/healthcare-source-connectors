<!-- NetBeans custom actions for the root project: right-click the project > Run Maven > (action).
     Performance tests (design §13.1), the same as scripts/perf.sh: throughput, per-item latency and memory use of each
     part of the pipeline, in shared columns. They run only through these actions or -Pperf, never in a normal build or
     with the integration tests (-Pit). The stages, in order (perf.stages):
       core      split, encrypt and store without the apps (connector-core ThroughputPerf), one bulk file per format
       landing   the real landing node (landing-connector LandingPerf): bulk files through a directory intake, and
                 many small C-CDA documents at a steady rate through a directory and through HTTP push with mTLS
       split     the real splitter (file-connector SplitterPerf), fed the same items at the landing run's
                 announcements; then end to end, each item's landing plus splitting latency
     Results: printed in the Output window, and written to target/perf/ at the root:
       pipeline-summary.md   each workload's latest landing, split, end-to-end and core rows side by side
       <stage>.md            each stage's latest run (throughput, latency and memory tables)
       history.csv           one row per stage, workload and intake per run, kept until `mvn clean`
     Change a property here, or copy an action, for other settings: perf.size, perf.items, perf.rate, perf.workloads,
     perf.intakes, perf.formats (core; add csv), perf.recipient (rsa), perf.heap. perf.storage=s3 needs the minikube
     environment, so run that one with scripts/perf.sh.
     Demo (design §15.3): the landing node and the splitter as separate processes, joined by a broker, with C-CDA
     files through a watched directory and pushes over HTTPS; both apps' logs and OpenTelemetry output in the Output
     window, kept in file-connector/target/demo/ (logs/, telemetry/ with report.md, output/). Without Docker, or
     against containers in the minikube VM. Only these actions or -Pdemo run it.
     Distribution (design §14): every app's customer tarballs (-Pdist), or their service and customer images built into
     the minikube VM (-Pimages, the VM stopped afterwards). Both fail if third-party attribution is incomplete. -->
<actions>
    <action>
        <actionName>CUSTOM-performance-test</actionName>
        <displayName>Performance test (pipeline: core, landing, split)</displayName>
        <!-- Every stage, then the summary. 1 GiB heap, as in a 2 GiB Kubernetes container (design §14.1). -->
        <goals>
            <goal>-pl</goal>
            <goal>landing-connector,file-connector</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>perf</activatedProfile>
        </activatedProfiles>
        <properties>
            <perf.stages>core,landing,split</perf.stages>
            <perf.workloads>bulk-ccda,bulk-x12,small-ccda</perf.workloads>
            <perf.intakes>directory,http</perf.intakes>
            <perf.size>1GiB</perf.size>
            <perf.items>1000</perf.items>
            <perf.rate>10</perf.rate>
            <perf.formats>ccda,x12</perf.formats>
            <perf.storage>local</perf.storage>
            <perf.recipient>ec</perf.recipient>
            <perf.heap>1024m</perf.heap>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-performance-test-quick</actionName>
        <displayName>Performance test (pipeline, quick)</displayName>
        <!-- A check that every stage runs, in a few minutes; the numbers mean little at this size. -->
        <goals>
            <goal>-pl</goal>
            <goal>landing-connector,file-connector</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>perf</activatedProfile>
        </activatedProfiles>
        <properties>
            <perf.stages>core,landing,split</perf.stages>
            <perf.workloads>bulk-ccda,bulk-x12,small-ccda</perf.workloads>
            <perf.intakes>directory,http</perf.intakes>
            <perf.size>64MiB</perf.size>
            <perf.items>100</perf.items>
            <perf.rate>20</perf.rate>
            <perf.formats>ccda,x12</perf.formats>
            <perf.storage>local</perf.storage>
            <perf.recipient>ec</perf.recipient>
            <perf.heap>1024m</perf.heap>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-performance-test-landing</actionName>
        <displayName>Performance test (landing)</displayName>
        <!-- The landing node only. Its timelines are kept, for a later split run to replay. -->
        <goals>
            <goal>-pl</goal>
            <goal>landing-connector,file-connector</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>perf</activatedProfile>
        </activatedProfiles>
        <properties>
            <perf.stages>landing</perf.stages>
            <perf.workloads>bulk-ccda,bulk-x12,small-ccda</perf.workloads>
            <perf.intakes>directory,http</perf.intakes>
            <perf.size>1GiB</perf.size>
            <perf.items>1000</perf.items>
            <perf.rate>10</perf.rate>
            <perf.formats>ccda,x12</perf.formats>
            <perf.storage>local</perf.storage>
            <perf.recipient>ec</perf.recipient>
            <perf.heap>1024m</perf.heap>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-performance-test-landing-quick</actionName>
        <displayName>Performance test (landing, quick)</displayName>
        <!-- A check that the landing stage runs, in under a minute. -->
        <goals>
            <goal>-pl</goal>
            <goal>landing-connector,file-connector</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>perf</activatedProfile>
        </activatedProfiles>
        <properties>
            <perf.stages>landing</perf.stages>
            <perf.workloads>bulk-ccda,bulk-x12,small-ccda</perf.workloads>
            <perf.intakes>directory,http</perf.intakes>
            <perf.size>64MiB</perf.size>
            <perf.items>100</perf.items>
            <perf.rate>20</perf.rate>
            <perf.formats>ccda,x12</perf.formats>
            <perf.storage>local</perf.storage>
            <perf.recipient>ec</perf.recipient>
            <perf.heap>1024m</perf.heap>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-performance-test-core</actionName>
        <displayName>Performance test (core: split, encrypt, store)</displayName>
        <!-- The split micro-benchmark without the apps, as the performance test was before the landing stage. -->
        <goals>
            <goal>-pl</goal>
            <goal>landing-connector,file-connector</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>perf</activatedProfile>
        </activatedProfiles>
        <properties>
            <perf.stages>core</perf.stages>
            <perf.workloads>bulk-ccda,bulk-x12,small-ccda</perf.workloads>
            <perf.intakes>directory,http</perf.intakes>
            <perf.size>1GiB</perf.size>
            <perf.items>1000</perf.items>
            <perf.rate>10</perf.rate>
            <perf.formats>ccda,x12</perf.formats>
            <perf.storage>local</perf.storage>
            <perf.recipient>ec</perf.recipient>
            <perf.heap>1024m</perf.heap>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-performance-test-small-heap</actionName>
        <displayName>Performance test (pipeline, 512 MiB heap)</displayName>
        <!-- The smallest comfortable heap (design §13.1): shows the memory and speed cost of a smaller pod. -->
        <goals>
            <goal>-pl</goal>
            <goal>landing-connector,file-connector</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>perf</activatedProfile>
        </activatedProfiles>
        <properties>
            <perf.stages>core,landing,split</perf.stages>
            <perf.workloads>bulk-ccda,bulk-x12,small-ccda</perf.workloads>
            <perf.intakes>directory,http</perf.intakes>
            <perf.size>1GiB</perf.size>
            <perf.items>1000</perf.items>
            <perf.rate>10</perf.rate>
            <perf.formats>ccda,x12</perf.formats>
            <perf.storage>local</perf.storage>
            <perf.recipient>ec</perf.recipient>
            <perf.heap>512m</perf.heap>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-demo</actionName>
        <displayName>Demo (pipeline, no Docker)</displayName>
        <!-- Demonstration (design §15.3): two pipelines, each a landing node, a split stage and a convert stage
             run from their JARs. Files dropped into a watched directory, then pushes over HTTPS with mTLS, with
             failures along the way; each item's way through on the console, then the converted documents read
             back. Embedded Postgres, tables on local disk and an embedded Artemis broker; a few minutes. Output:
             file-connector/target/demo/. -->
        <goals>
            <goal>-pl</goal>
            <goal>landing-connector,convert-stage,file-connector</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>demo</activatedProfile>
        </activatedProfiles>
        <properties>
            <demo.stack>local</demo.stack>
            <demo.pause>3s</demo.pause>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-demo-vm</actionName>
        <displayName>Demo (pipeline, full stack in the VM)</displayName>
        <!-- The same demo against Postgres, SeaweedFS (S3) and Kafka as containers in the sdh-it minikube VM, which is
             started if needed and stopped afterwards (demo.stop-vm=false keeps it running). A few minutes. -->
        <goals>
            <goal>-pl</goal>
            <goal>landing-connector,convert-stage,file-connector</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>demo</activatedProfile>
        </activatedProfiles>
        <properties>
            <demo.stack>vm</demo.stack>
            <demo.pause>3s</demo.pause>
            <demo.stop-vm>true</demo.stop-vm>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-distribution-tarball</actionName>
        <displayName>Build distribution tarballs (all apps)</displayName>
        <!-- <app>/target/<app>-<version>-dist.tar.gz for each app, for customers (design
             §14.3). Fails if a license text can't be fetched, or THIRD-PARTY.txt misses anything the jars bundle
             (ThirdPartyAttributionIT, §14.2). -->
        <goals>
            <goal>-pl</goal>
            <goal>landing-connector,file-connector,convert-stage</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>dist</activatedProfile>
        </activatedProfiles>
        <properties>
            <skipTests>true</skipTests>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-images</actionName>
        <displayName>Build container images (all apps, into the VM)</displayName>
        <!-- The service and customer images of each app, built by scripts/build-image.sh
             into the sdh-it VM's Docker from what this build packaged (design §14.1, §14.3), after the same
             attribution checks as the tarballs. The VM is stopped afterwards. Signing and pushing a release is
             scripts/sign-release.sh (§14.4). -->
        <goals>
            <goal>-pl</goal>
            <goal>landing-connector,file-connector,convert-stage</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>images</activatedProfile>
        </activatedProfiles>
        <properties>
            <skipTests>true</skipTests>
            <images.stop-vm>true</images.stop-vm>
        </properties>
    </action>
</actions>
