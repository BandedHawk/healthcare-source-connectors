<?xml version="1.0" encoding="UTF-8"?>
<!-- NetBeans custom actions for the root project: right-click the project > Run Maven > (action).
     Performance tests (design §13.1): throughput and memory use for C-CDA and X12, the same as scripts/perf.sh. They run
     only through these actions or -Pperf, never in a normal build or with the integration tests (-Pit).
     Results: printed in the Output window at the end, and written to connector-core/target/perf/:
       throughput-<storage>-<recipient>.md   this run (a throughput table and a memory table)
       history.csv                           one row per format per run, kept until `mvn clean`
     Change a property here, or copy an action, for other settings: perf.size, perf.formats (add csv),
     perf.recipient (rsa), perf.heap. perf.storage=s3 needs the minikube environment, so run that one with
     scripts/perf.sh.
     Demo (design §15.3): C-CDA files through the connector with its log and OpenTelemetry output in the Output window,
     in-process or against containers in the minikube VM. Only these actions or -Pdemo run it. -->
<actions>
    <action>
        <actionName>CUSTOM-performance-test</actionName>
        <displayName>Performance test (C-CDA, X12)</displayName>
        <!-- 1 GiB heap, as in a 2 GiB Kubernetes container (design §14.1). -->
        <goals>
            <goal>-pl</goal>
            <goal>connector-core</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>perf</activatedProfile>
        </activatedProfiles>
        <properties>
            <perf.size>1GiB</perf.size>
            <perf.formats>ccda,x12</perf.formats>
            <perf.storage>local</perf.storage>
            <perf.recipient>ec</perf.recipient>
            <perf.heap>1024m</perf.heap>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-performance-test-quick</actionName>
        <displayName>Performance test (quick, 64 MiB)</displayName>
        <!-- A check that the test runs, in under a minute; the numbers mean little at this size. -->
        <goals>
            <goal>-pl</goal>
            <goal>connector-core</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>perf</activatedProfile>
        </activatedProfiles>
        <properties>
            <perf.size>64MiB</perf.size>
            <perf.formats>ccda,x12</perf.formats>
            <perf.storage>local</perf.storage>
            <perf.recipient>ec</perf.recipient>
            <perf.heap>1024m</perf.heap>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-performance-test-small-heap</actionName>
        <displayName>Performance test (512 MiB heap)</displayName>
        <!-- The smallest comfortable heap (design §13.1): shows the memory and speed cost of a smaller pod. -->
        <goals>
            <goal>-pl</goal>
            <goal>connector-core</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>perf</activatedProfile>
        </activatedProfiles>
        <properties>
            <perf.size>1GiB</perf.size>
            <perf.formats>ccda,x12</perf.formats>
            <perf.storage>local</perf.storage>
            <perf.recipient>ec</perf.recipient>
            <perf.heap>512m</perf.heap>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-demo</actionName>
        <displayName>Demo (in-process)</displayName>
        <!-- Demonstration (design §15.3): C-CDA files delivered one by one, with the connector's log, audit events and
             OpenTelemetry traces and metrics in the Output window, a failure mix, then the converted documents read
             back. One JVM, no Docker, under a minute. Output: file-connector/target/demo/. -->
        <goals>
            <goal>-pl</goal>
            <goal>file-connector</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>demo</activatedProfile>
        </activatedProfiles>
        <properties>
            <demo.stack>local</demo.stack>
            <demo.pause>3s</demo.pause>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-demo-vm</actionName>
        <displayName>Demo (full stack in the VM)</displayName>
        <!-- The same demo as deployed: Postgres, SeaweedFS (S3) and Kafka as containers in the sdh-it minikube VM,
             which is started if needed and stopped afterwards (demo.stop-vm=false keeps it running). A few minutes. -->
        <goals>
            <goal>-pl</goal>
            <goal>file-connector</goal>
            <goal>-am</goal>
            <goal>verify</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>demo</activatedProfile>
        </activatedProfiles>
        <properties>
            <demo.stack>vm</demo.stack>
            <demo.pause>3s</demo.pause>
            <demo.stop-vm>true</demo.stop-vm>
        </properties>
    </action>
    <action>
        <actionName>CUSTOM-distribution-tarball</actionName>
        <displayName>Build distribution tarball</displayName>
        <!-- file-connector/target/file-connector-<version>-dist.tar.gz, for customers (design §14.3). -->
        <goals>
            <goal>-pl</goal>
            <goal>file-connector</goal>
            <goal>-am</goal>
            <goal>package</goal>
        </goals>
        <activatedProfiles>
            <activatedProfile>dist</activatedProfile>
        </activatedProfiles>
        <properties>
            <skipTests>true</skipTests>
        </properties>
    </action>
</actions>
