# Base images, pinned by digest (design §14.5). This is the only place they're set: scripts/build-image.sh,
# ServiceImageIT and CustomerImageIT read this file.
#
# Each pin is <image>:<tag>@sha256:<digest>: the tag is what we follow, the digest is what we build. Renovate
# (renovate.json) opens a pull request when a tag moves to a new digest; scripts/base-images.sh checks or updates
# the pins by hand. After an update, re-run the image tests before releasing.

# Customer image (§14.3). The nonroot tag matches the kit Dockerfile's default; the image runs as 10001 either way.
DISTROLESS_IMAGE=gcr.io/distroless/java25-debian13:nonroot@sha256:a90a5fadd78dc37b643da72dca2f744ef67eba625eca7227a5b375b548e6b1c2
# Service image (§14.1): the runtime base and the build stage.
TEMURIN_JRE_IMAGE=eclipse-temurin:25-jre-noble@sha256:a98128a57de944a72bd31fbc79b898edd5a5864d3652071d5bbd2160ab7d7dce
TEMURIN_JDK_IMAGE=eclipse-temurin:25-jdk-noble@sha256:95e350ad1eb738f943e141640f7e3d797e483359a3b33c3864255bfd1ad71f8a
